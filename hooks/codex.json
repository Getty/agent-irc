{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "irc",
            "tool": "event",
            "async": true,
            "timeout": 5,
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "model": "${model}",
              "turn_id": "${turn_id}",
              "prompt": "${prompt}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "irc",
